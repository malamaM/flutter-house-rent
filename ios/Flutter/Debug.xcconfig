#include? "Pods/Target Support Files/Pods-Runner/Pods-Runner.debug.xcconfig"
#include "Generated.xcconfig"
// Xcode 26 can build the aggregate Pods_Runner framework in DerivedData while
// Flutter places Runner.app in its custom build directory. Keep both visible
// to the linker so workspace and Flutter CLI launches behave identically.
FRAMEWORK_SEARCH_PATHS = $(inherited) "$(PODS_CONFIGURATION_BUILD_DIR)"
